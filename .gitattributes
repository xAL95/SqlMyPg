# Normalise line endings on the way in and check out LF everywhere. This project is developed on
# Windows against a Linux Postgres, and the shell scripts and Dockerfile break if they land as CRLF.
* text=auto eol=lf

# Windows-only entry points keep CRLF so they run from Explorer as well as from a shell.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch these.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
