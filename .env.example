# SqlMyPg server configuration. Copy to .env (which is gitignored) and edit.
# Every variable below is read by the server; the values here are the defaults.

# development | production - production turns on secure-cookie defaults and static file serving
NODE_ENV=development
# interface the Fastify server binds to; 0.0.0.0 in a container
HOST=127.0.0.1
# HTTP + WebSocket port of the server (Vite dev server on 5273 proxies /api and /ws here)
PORT=5274

# Metadata database (users, saved connections, history, sessions metadata) - NOT the databases you browse.
# WSL2 example, exactly what scripts/setup-wsl-pg.sh prints:
APP_DATABASE_URL=postgres://sqlmypg:PASSWORD_FROM_SETUP_SCRIPT@127.0.0.1:5432/sqlmypg

# Signs session cookies and encrypts stored connection passwords. CHANGING IT LOGS EVERYONE OUT
# and makes stored connection passwords unreadable. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=CHANGE_ME_32_RANDOM_BYTES

# How long an unused query session is kept before it is reaped and its Postgres backend released.
# Doubles as idle_in_transaction_session_timeout, so an abandoned tab cannot hold locks forever.
SESSION_IDLE_TIMEOUT_MS=1800000
# Concurrent pinned query sessions per user - each one holds a real Postgres backend open
SESSION_MAX_PER_USER=10

# statement_timeout applied to every new query session; 0 disables it
DEFAULT_STATEMENT_TIMEOUT_MS=30000
# rows materialised per statement before the rest stays behind a server-side cursor
DEFAULT_MAX_ROWS=1000
# hard ceiling a client may ask for via ExecRequest.maxRows
MAX_MAX_ROWS=100000

# Email + password accounts. The first account created becomes admin. Set to false for OIDC-only.
LOCAL_AUTH=true

# OIDC single sign-on - leave all four empty to disable it
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5274/api/auth/oidc/callback
# Text on the SSO button, e.g. "Sign in with Entra ID"
OIDC_LABEL=

# Send session cookies with Secure - required for real HTTPS, must be false on plain http://localhost
COOKIE_SECURE=false
# Trust X-Forwarded-* headers. Only true when a reverse proxy you control sets them.
TRUST_PROXY=false

# Built web assets to serve in production. Empty in dev: Vite serves the UI on 5273.
WEB_DIST=
